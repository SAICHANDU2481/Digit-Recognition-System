# ==========================================
# Google Gemini API Key (Secret)
# ==========================================
# Get your API key from Google AI Studio: https://aistudio.google.com/
# On Render: Set this as a secret Environment Variable in Dashboard.
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Production Server & CORS Configuration
# ==========================================
# Comma-separated frontend domains permitted to access the API.
# Examples:
#   Local only: http://localhost:5173
#   Production: https://your-app.vercel.app,http://localhost:5173
#   Any origin: *
ALLOWED_ORIGINS=*

# ==========================================
# Local Development Settings
# ==========================================
# (Note: Cloud hosting like Render automatically sets PORT=10000)
PORT=5000
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
FLASK_DEBUG=False
